{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HomeTV API (debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--reload",
                "--reload-dir",
                "${workspaceFolder}"
            ],
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "console": "integratedTerminal",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Uvicorn running on http://0\\.0\\.0\\.0:([0-9]+)",
                "uriFormat": "http://localhost:%s/docs"
            }
        }
    ]
}